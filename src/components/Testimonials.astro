---
import { clientReviews } from '../data/reviews';

const stars = [1, 2, 3, 4, 5] as const;
---

{
	clientReviews.length > 0 && (
		<section id="testimonials" class="py-24 px-6 bg-white">
			<div class="max-w-7xl mx-auto">
				<div class="text-center mb-16 max-w-2xl mx-auto">
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-brand mb-3">What clients say</p>
					<h2 class="text-4xl font-bold text-brand-dark mb-4 font-serif">Recent reviews</h2>
					<p class="text-gray-600 leading-relaxed">
						Real feedback from homeowners we have worked with — and the gardens they now enjoy.
					</p>
				</div>

				<div class="space-y-8">
					{clientReviews.map((review) => (
						<article class="overflow-hidden rounded-sm shadow-sm border border-brand-border bg-white grid md:grid-cols-2">
							{/* Same photo footprint as Our work cards: ~half row width × h-72 */}
							<img
								src={review.photo}
								alt={review.photoAlt}
								width="800"
								height="288"
								class="w-full h-72 object-cover object-center"
								loading="lazy"
								decoding="async"
							/>
							<div class="p-5 md:p-8 flex flex-col justify-center border-t md:border-t-0 md:border-l border-brand-border">
								<div class="flex items-center gap-1 mb-3" aria-label={`${review.rating} out of 5 stars`}>
									{stars.map((value) => (
										<svg
											class={`h-5 w-5 ${value <= review.rating ? 'text-brand' : 'text-brand-border'}`}
											viewBox="0 0 24 24"
											aria-hidden="true"
										>
											<path
												d="M12 2.5l2.9 6.1 6.6.7-5 4.6 1.4 6.5L12 17.8 6.1 20.4 7.5 13.9l-5-4.6 6.6-.7L12 2.5z"
												fill="currentColor"
											/>
										</svg>
									))}
								</div>
								<p class="font-bold text-brand-dark font-serif text-2xl md:text-3xl mb-3 leading-snug">
									“{review.experience}”
								</p>
								<p class="text-sm text-gray-600 leading-relaxed">{review.name}</p>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>
	)
}

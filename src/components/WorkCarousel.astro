---
import { recentWork } from '../data/images';

const slides = [...recentWork, ...recentWork];
---

<section class="bg-brand-bg pt-10 md:pt-12 pb-12 md:pb-14 overflow-hidden" data-work-carousel>
	<div class="max-w-7xl mx-auto px-6 mb-5 md:mb-6">
		<p class="text-xs font-bold uppercase tracking-[0.2em] text-brand">Latest project</p>
	</div>

	<div class="relative">
		<div class="carousel-fade carousel-fade-left" aria-hidden="true"></div>
		<div class="carousel-fade carousel-fade-right" aria-hidden="true"></div>

		<div
			class="carousel-viewport overflow-hidden"
			data-carousel-viewport
			role="region"
			aria-label="Latest project photos"
		>
			<div class="carousel-rail flex gap-4 md:gap-5 w-max will-change-transform" data-carousel-rail>
				{
					slides.map((slide, index) => (
						<div class="carousel-slide shrink-0 w-[72vw] sm:w-[280px] md:w-[340px]">
							<button
								type="button"
								class="photo-thumb relative block aspect-[4/3] w-full overflow-hidden bg-brand-light focus:outline-none focus-visible:ring-2 focus-visible:ring-brand"
								data-open-photo
								data-src={slide.src}
								data-alt={slide.alt}
								aria-label={`Enlarge photo ${index + 1}`}
							>
								<img
									src={slide.src}
									alt={slide.alt}
									width="680"
									height="510"
									class="h-full w-full object-cover pointer-events-none"
									loading={index < 4 ? 'eager' : 'lazy'}
									decoding="async"
								/>
							</button>
						</div>
					))
				}
			</div>
		</div>
	</div>

	<dialog
		class="photo-lightbox m-0 max-w-none w-full h-full bg-transparent p-0"
		data-photo-lightbox
		aria-label="Enlarged project photo"
	>
		<div class="photo-lightbox-shell flex min-h-full items-center justify-center p-3 sm:p-6 md:p-10" data-lightbox-shell>
			<button
				type="button"
				class="absolute top-4 right-4 z-20 inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/30 bg-brand-dark/70 text-white hover:bg-brand-dark hover:border-white/60"
				data-close-photo
				aria-label="Close"
			>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
			</button>
			<img
				class="photo-lightbox-img max-h-[88vh] max-w-[94vw] w-auto h-auto object-contain shadow-2xl shadow-black/40"
				data-lightbox-img
				alt=""
			/>
		</div>
	</dialog>
</section>

<style>
	.carousel-viewport {
		mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
	}

	.carousel-rail {
		animation: workDrift 55s linear infinite;
	}

	.carousel-viewport.is-paused .carousel-rail,
	[data-work-carousel].is-lightbox-open .carousel-rail {
		animation-play-state: paused;
	}

	@keyframes workDrift {
		from {
			transform: translate3d(0, 0, 0);
		}
		to {
			transform: translate3d(-50%, 0, 0);
		}
	}

	.carousel-fade {
		pointer-events: none;
		position: absolute;
		top: 0;
		bottom: 0;
		width: 2.5rem;
		z-index: 2;
	}

	.carousel-fade-left {
		left: 0;
		background: linear-gradient(90deg, var(--color-brand-bg), transparent);
	}

	.carousel-fade-right {
		right: 0;
		background: linear-gradient(270deg, var(--color-brand-bg), transparent);
	}

	.photo-thumb {
		cursor: zoom-in;
		transition: transform 0.35s ease;
	}

	.photo-thumb:hover {
		transform: scale(1.02);
	}

	.photo-lightbox[open] {
		display: block;
	}

	.photo-lightbox::backdrop {
		background: rgba(30, 63, 32, 0.88);
		backdrop-filter: blur(8px);
	}

	.photo-lightbox-shell {
		position: relative;
		cursor: zoom-out;
	}

	.photo-lightbox-img {
		cursor: default;
	}

	@media (prefers-reduced-motion: reduce) {
		.carousel-rail {
			animation: none;
		}

		.photo-thumb {
			transition: none;
		}
	}
</style>

<script>
	function initWorkCarousel() {
		const root = document.querySelector<HTMLElement>('[data-work-carousel]');
		const viewport = root?.querySelector<HTMLElement>('[data-carousel-viewport]');
		const lightbox = root?.querySelector<HTMLDialogElement>('[data-photo-lightbox]');
		const lightboxImg = root?.querySelector<HTMLImageElement>('[data-lightbox-img]');
		const closeBtn = root?.querySelector<HTMLButtonElement>('[data-close-photo]');
		if (!root || !viewport || !lightbox || !lightboxImg) return;

		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (reduce) viewport.classList.add('is-paused');

		viewport.addEventListener('pointerenter', () => {
			if (!root.classList.contains('is-lightbox-open')) viewport.classList.add('is-paused');
		});
		viewport.addEventListener('pointerleave', () => {
			if (!root.classList.contains('is-lightbox-open') && !reduce) {
				viewport.classList.remove('is-paused');
			}
		});

		const openPhoto = (src: string, alt: string) => {
			lightboxImg.src = src;
			lightboxImg.alt = alt;
			root.classList.add('is-lightbox-open');
			viewport.classList.add('is-paused');
			lightbox.showModal();
		};

		const closePhoto = () => {
			lightbox.close();
			lightboxImg.removeAttribute('src');
			lightboxImg.alt = '';
			root.classList.remove('is-lightbox-open');
			if (!reduce) viewport.classList.remove('is-paused');
		};

		root.querySelectorAll<HTMLButtonElement>('[data-open-photo]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const src = btn.dataset.src ?? '';
				const alt = btn.dataset.alt ?? '';
				if (src) openPhoto(src, alt);
			});
		});

		closeBtn?.addEventListener('click', (e) => {
			e.stopPropagation();
			closePhoto();
		});

		lightbox.addEventListener('click', (e) => {
			const shell = lightbox.querySelector('[data-lightbox-shell]');
			if (e.target === shell || e.target === lightbox) closePhoto();
		});

		lightbox.addEventListener('cancel', (e) => {
			e.preventDefault();
			closePhoto();
		});
	}

	initWorkCarousel();
</script>
